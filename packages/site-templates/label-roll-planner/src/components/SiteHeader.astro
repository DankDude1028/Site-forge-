---
const { mode } = Astro.props;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/">
      <svg class="brand-mark" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
        <circle class="brand-roll-outer" cx="15" cy="18" r="12" fill="none" stroke="currentColor" stroke-width="2.5" />
        <circle class="brand-roll-ring" cx="15" cy="18" r="8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3" />
        <circle cx="15" cy="18" r="4" fill="#b98b5e" stroke="currentColor" stroke-width="2" />
        <path class="brand-web" d="M15 6h18v11" fill="none" stroke="#f4be4f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        <rect x="27" y="13" width="6" height="5" rx="1" fill="#f4be4f" />
      </svg>
      <span>Rollwise</span>
    </a>
    <span class="descriptor">Label roll calculator</span>
    <nav class="site-nav" aria-label="Page sections">
      <a href="/#planner-title">Calculator</a>
      <a href="/#compare-title">Roll sizes</a>
      <a href="/#how">Formula</a>
      <a href="/#faq-title">FAQ</a>
      <a href="/privacy/">Privacy</a>
    </nav>
    <div class="header-marks" aria-hidden="true">
      <span class="color-bars">
        <i class="cb-ink"></i><i class="cb-kraft"></i><i class="cb-accent"></i><i class="cb-gold"></i>
      </span>
    </div>
    {mode === 'preview' && <span class="proof">Proof · not published</span>}
  </div>
</header>
