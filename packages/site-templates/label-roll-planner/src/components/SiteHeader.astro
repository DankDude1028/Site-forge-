---
const { mode } = Astro.props;
---
<header class="site-header shell">
  <a class="brand" href="/">
    <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
      <circle cx="13" cy="16" r="11" fill="none" stroke="currentColor" stroke-width="2.5" />
      <circle cx="13" cy="16" r="4" fill="none" stroke="currentColor" stroke-width="2.5" />
      <path d="M13 5h17v8" fill="none" stroke="currentColor" stroke-width="2.5" />
    </svg>
    Rollwise
  </a>
  <span class="descriptor">Label roll calculator</span>
  {mode === 'preview' && <span class="proof">Proof · not published</span>}
</header>
