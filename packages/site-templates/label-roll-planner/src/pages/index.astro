---
import '@fontsource/bricolage-grotesque/latin-600.css';
import '@fontsource/bricolage-grotesque/latin-700.css';
import '@fontsource/bricolage-grotesque/latin-800.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { BATCH_PRESETS, compareRollSizes, computeRollTelemetry, planLabels } from '../lib/planner.ts';
import { getSiteConfig } from '../../site-config.mjs';

const config = getSiteConfig();
const canonical = new URL('/', Astro.site);

const defaultInput = BATCH_PRESETS[0].inputs;
const defaultPlan = planLabels(defaultInput);
const defaultTelemetry = computeRollTelemetry(defaultInput, defaultPlan);
const defaultComparison = compareRollSizes(defaultInput);

const faqs = [
  {
    q: 'Why does Rollwise round up twice?',
    a: 'Printers cannot feed a fraction of a label, and suppliers do not sell a fraction of a roll. Rollwise first rounds your batch plus setup allowance up to a whole label, then divides by roll capacity and rounds up to whole rolls.',
  },
  {
    q: 'How much extra allowance should I add for setup and misprints?',
    a: 'There is no single percentage for every shop. Hand-applied runs mainly lose occasional crooked or wrinkled labels, while printers and applicators also use a fixed length of label web each time you thread the rollers and align registration. On a short batch, that fixed setup strip is a larger share of the run than on a long batch—check how many labels your setup typically uses and set the allowance % to cover it.',
  },
  {
    q: 'What if I have a partly used roll on the shelf?',
    a: 'Enter only unopened full rolls in "Full rolls you already have" so your order is never short. If you know the exact count remaining on an open roll, you can subtract that count from your batch items before ordering.',
  },
  {
    q: 'Does changing roll size affect how many spare labels are left over?',
    a: 'Yes. When your batch total is not an exact multiple of the roll capacity, rounding up to a whole roll leaves spare labels on the final roll. Use the Roll-Size Optimizer above to compare how different roll capacities change your order count and leftover labels—just confirm your printer or dispenser accepts the physical roll diameter.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Rollwise label roll calculator',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description:
      'Work out how many label rolls to order for your next small batch. Rounds up to whole labels and whole rolls, adds an allowance for setup and misprints, and runs entirely in your browser.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(item => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
].map(item => JSON.stringify(item).replace(/</g, '\\u003c'));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Label roll calculator: how many rolls to order | Rollwise</title>
    <meta name="description" content="Work out how many label rolls to order for your next small batch. Rounds up to whole labels and whole rolls, adds an allowance for setup and misprints, and runs entirely in your browser." />
    <meta name="robots" content={config.robots} />
    <meta name="theme-color" content="#132226" />
    <link rel="canonical" href={canonical} />
    {jsonLd.map(json => <script type="application/ld+json" set:html={json} />)}
  </head>
  <body>
    <a href="#main" class="skip">Skip to calculator</a>
    <SiteHeader mode={config.mode} />
    <main id="main" class="home">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid-bg" aria-hidden="true"></div>
        <div class="shell hero-bar">
          <div class="intro">
            <p class="eyebrow on-dark">Small-batch label press instrument</p>
            <h1 id="hero-title">How many label rolls does this batch <em>really</em> need?</h1>
            <p class="lede">Enter your batch and your roll size. Rollwise rounds up to whole labels and whole rolls, adds a small allowance for setup and misprints, and takes off the rolls already on your shelf.</p>
          </div>
          <div class="hero-side">
            <p class="trust">No inputs leave your browser. No account, no ads, no tracking.</p>
            <div class="preset-dock" role="group" aria-label="Sample batch presets">
              <span class="preset-kicker">Load a sample run</span>
              <div class="preset-chips">
                {BATCH_PRESETS.map((preset, idx) => (
                  <button
                    type="button"
                    class="preset-chip"
                    data-preset={preset.id}
                    data-quantity={preset.inputs.quantity}
                    data-labels={preset.inputs.labelsPerItem}
                    data-per-roll={preset.inputs.labelsPerRoll}
                    data-on-hand={preset.inputs.rollsOnHand}
                    data-waste={preset.inputs.wastePercent}
                    aria-pressed={idx === 0 ? 'true' : 'false'}
                  >
                    <strong>{preset.name}</strong>
                    <span>{preset.tag}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="shell instrument-shell">
          <section class="sheet" aria-labelledby="planner-title">
            <div class="planner press-instrument">
              <div class="press-zone zone-controls">
                <div class="zone-header">
                  <span class="zone-step">01 · Press Controls</span>
                  <h2 id="planner-title">Plan your label run</h2>
                  <p class="planner-intro">Results update as you type.</p>
                </div>
                <form id="planner" novalidate>
                  <div class="fields">
                    <div class="field-card span-2">
                      <div class="label-row">
                        <label for="quantity">Items in this batch</label>
                        <span class="unit-tag">units</span>
                      </div>
                      <input id="quantity" name="quantity" type="number" min="1" max="1000000" step="1" value="250" required inputmode="numeric" aria-describedby="quantity-error" />
                      <input id="quantity-range" class="batch-slider" type="range" min="10" max="5000" step="10" value="250" aria-label="Batch size slider" />
                      <p class="field-error" id="quantity-error"></p>
                    </div>

                    <div class="field-card">
                      <div class="label-row">
                        <label for="labels">Labels per item</label>
                        <span class="unit-tag">per unit</span>
                      </div>
                      <input id="labels" name="labels" type="number" min="1" max="100" step="1" value="2" required inputmode="numeric" aria-describedby="labels-error" />
                      <div class="mini-chips" role="group" aria-label="Placement count presets">
                        {[1, 2, 3, 4].map(val => (
                          <button type="button" class="mini-chip" data-target="labels" data-value={val} aria-pressed={val === 2 ? 'true' : 'false'}>
                            {val === 1 ? '1 · Front' : val === 2 ? '2 · F+B' : val === 3 ? '3 · +Seal' : '4 · Set'}
                          </button>
                        ))}
                      </div>
                      <p class="field-error" id="labels-error"></p>
                    </div>

                    <div class="field-card">
                      <div class="label-row">
                        <label for="perRoll">Labels on each roll</label>
                        <span class="unit-tag">roll cap</span>
                      </div>
                      <input id="perRoll" name="perRoll" type="number" min="1" max="1000000" step="1" value="500" required inputmode="numeric" aria-describedby="perRoll-error" />
                      <div class="mini-chips" role="group" aria-label="Roll capacity presets">
                        {[250, 500, 1000, 2500].map(val => (
                          <button type="button" class="mini-chip" data-target="perRoll" data-value={val} aria-pressed={val === 500 ? 'true' : 'false'}>
                            {val.toLocaleString('en-US')}
                          </button>
                        ))}
                      </div>
                      <p class="field-error" id="perRoll-error"></p>
                    </div>

                    <div class="field-card span-2">
                      <div class="label-row">
                        <label for="onHand">Full rolls you already have</label>
                        <span class="unit-tag">on shelf</span>
                      </div>
                      <div class="inline-control-row">
                        <input id="onHand" name="onHand" type="number" min="0" max="1000000" step="1" value="1" required inputmode="numeric" aria-describedby="onHand-error" />
                        <div class="mini-chips" role="group" aria-label="Shelf stock presets">
                          {[0, 1, 2, 5].map(val => (
                            <button type="button" class="mini-chip" data-target="onHand" data-value={val} aria-pressed={val === 1 ? 'true' : 'false'}>
                              {val}
                            </button>
                          ))}
                        </div>
                      </div>
                      <p class="field-error" id="onHand-error"></p>
                    </div>
                  </div>

                  <div class="allowance">
                    <div class="allowance-copy">
                      <label for="waste">Extra allowance (%)</label>
                      <p class="help" id="waste-help">For setup, misprints and the occasional crooked label.</p>
                      <div class="mini-chips" role="group" aria-label="Setup percentage presets">
                        {[0, 3, 5, 10].map(val => (
                          <button type="button" class="mini-chip" data-target="waste" data-value={val} aria-pressed={val === 5 ? 'true' : 'false'}>
                            {val}%
                          </button>
                        ))}
                      </div>
                    </div>
                    <input id="waste" name="waste" type="number" min="0" max="100" step="0.1" value="5" required aria-describedby="waste-help waste-error" inputmode="decimal" />
                    <p class="field-error" id="waste-error"></p>
                  </div>

                  <button type="submit" class="submit-btn">Calculate my rolls</button>
                  <p class="live-hint">Results update as you type. The button jumps to your result.</p>
                  <p id="error" role="alert"></p>
                </form>
              </div>

              <div class="press-zone zone-visualizer" aria-hidden="true">
                <div class="viz-top-bar">
                  <span class="zone-step">02 · Live Press Telemetry</span>
                  <span class="viz-badge" id="viz-allowance">+{defaultTelemetry.allowanceLabels} allowance labels</span>
                </div>

                <div class="spool-stage" id="spool-stage">
                  <svg class="spool-svg" id="spool-svg" viewBox="0 0 260 230" focusable="false">
                    <defs>
                      <pattern id="spare-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                        <rect width="8" height="8" fill="#f3e6d3" />
                        <rect width="3.5" height="8" fill="#c29568" />
                      </pattern>
                    </defs>
                    <g class="reg-marks" stroke="#8a7968" stroke-width="1.2" fill="none">
                      <circle cx="20" cy="20" r="6" /><path d="M20 10v20M10 20h20" />
                      <circle cx="240" cy="20" r="6" /><path d="M240 10v20M230 20h20" />
                    </g>

                    <!-- Unspooling web path from main roll to guide roller -->
                    <path class="web-ribbon-bg" d="M 192 66 L 232 146 L 232 214" fill="none" stroke="#dfc9ad" stroke-width="18" stroke-linecap="round" stroke-linejoin="round" />
                    <path class="web-ribbon-labels" id="web-ribbon-labels" d="M 192 66 L 232 146 L 232 214" fill="none" stroke="#b83216" stroke-width="10" stroke-dasharray="14 8" stroke-linecap="butt" />

                    <!-- Guide roller -->
                    <g class="guide-roller-group" transform="translate(232 146)">
                      <circle r="16" fill="#142226" stroke="#dfc9ad" stroke-width="2.5" />
                      <g class="roller-spokes" stroke="#f4be4f" stroke-width="2">
                        <line x1="-10" y1="0" x2="10" y2="0" />
                        <line x1="0" y1="-10" x2="0" y2="10" />
                      </g>
                      <circle r="5" fill="#b98b5e" />
                    </g>

                    <!-- Main Label Roll Spool -->
                    <g class="main-spool" transform="translate(112 114)">
                      <circle r="96" fill="#fffdf9" stroke="#142226" stroke-width="2.5" />
                      <circle r="80" fill="none" stroke="url(#spare-hatch)" stroke-width="22" />
                      <circle
                        class="spool-arc-used"
                        id="spool-arc-used"
                        r="80"
                        fill="none"
                        stroke="#b83216"
                        stroke-width="22"
                        pathLength="100"
                        stroke-dasharray={`${defaultTelemetry.lastRollUsedPercent} 100`}
                        transform="rotate(-90)"
                      />
                      <g class="spool-windings" fill="none" stroke="#142226" stroke-opacity="0.18" stroke-width="1.2">
                        <circle r="66" stroke-dasharray="10 6" />
                        <circle r="58" stroke-dasharray="7 5" />
                        <circle r="50" stroke-dasharray="5 4" />
                      </g>
                      <circle r="44" fill="#b98b5e" stroke="#142226" stroke-width="2.5" />
                      <circle r="33" fill="#142226" stroke="#ead9c4" stroke-width="1.5" />
                      <text id="spool-pct" x="0" y="2" text-anchor="middle" class="spool-pct-text">{defaultTelemetry.lastRollUsedPercent}%</text>
                      <text x="0" y="16" text-anchor="middle" class="spool-sub-text">LAST ROLL</text>
                    </g>
                  </svg>
                  <p class="spool-telemetry-line" id="spool-used-detail">
                    Last roll uses {defaultTelemetry.lastRollUsed.toLocaleString('en-US')} of {defaultInput.labelsPerRoll.toLocaleString('en-US')} labels ({defaultPlan.labelsLeft.toLocaleString('en-US')} spare)
                  </p>
                </div>

                <div class="web-conveyor" id="web-conveyor">
                  <div class="conveyor-head">
                    <span>Die-cut label web feed</span>
                    <span id="viz-per-item">{defaultInput.labelsPerItem} labels / item</span>
                  </div>
                  <div class="web-viewport">
                    <div class="web-track" id="web-track">
                      {[1, 2, 3, 4, 1, 2, 3, 4].map((num, idx) => (
                        <span class="die-label">
                          <i class="die-hole"></i>
                          <b class="die-title">{idx % 2 === 0 ? 'FRONT' : 'BACK'} · #{num}</b>
                          <small class="die-meta">{defaultInput.labelsPerRoll}/ROLL · +{defaultInput.wastePercent}%</small>
                        </span>
                      ))}
                    </div>
                  </div>
                </div>

                <div class="shelf-rack">
                  <div class="conveyor-head">
                    <span>Roll shelf &amp; order strip</span>
                    <span id="viz-roll-count">{defaultPlan.rollsRequired} rolls total</span>
                  </div>
                  <div class="strip" id="strip" aria-hidden="true">
                    <span class="roll have" style="--i:0"></span>
                    <span class="roll order partial" style={`--i:1;--used:${defaultTelemetry.lastRollUsedPercent}%`}></span>
                  </div>
                  <div id="roll-caption" aria-hidden="true">
                    {defaultPlan.rollsToOrder} roll to order · {defaultPlan.labelsLeft} spare labels on the last roll
                  </div>
                  <p class="legend" aria-hidden="true">
                    <span><i class="key key-order"></i>to order</span>
                    <span><i class="key key-have"></i>already have</span>
                    <span><i class="key key-spare"></i>spare labels</span>
                  </p>
                  <ul class="roll-feed-list" id="roll-feed-list" aria-hidden="true">
                    <li class="feed-item is-have">
                      <div class="feed-item-head">
                        <strong>Roll 1 · On shelf</strong>
                        <span>500 / 500 labels (100%)</span>
                      </div>
                      <div class="feed-bar"><span style="width:100%"></span></div>
                    </li>
                    <li class="feed-item is-order">
                      <div class="feed-item-head">
                        <strong>Roll 2 · To order</strong>
                        <span>25 / 500 labels (5%)</span>
                      </div>
                      <div class="feed-bar"><span style="width:5%"></span></div>
                    </li>
                  </ul>
                </div>
              </div>

              <div class="press-zone zone-ticket">
                <output id="result" for="quantity labels perRoll onHand waste">
                  <div class="ticket-top">
                    <span class="zone-step">03 · Press Proof Ticket</span>
                    <p class="result-kind" id="result-kind">Sample batch. Change any number to plan yours.</p>
                  </div>

                  <p class="answer">
                    <strong id="order">{defaultPlan.rollsToOrder}</strong>
                    <span id="order-label">{defaultPlan.rollsToOrder === 1 ? 'roll to order' : 'rolls to order'}</span>
                  </p>
                  <p class="enough" id="enough" hidden>You already have enough rolls for this batch.</p>

                  <div class="capacity-meter" aria-hidden="true">
                    <div class="capacity-head">
                      <span>Total roll capacity breakdown</span>
                      <span id="capacity-total">{defaultTelemetry.totalCapacity.toLocaleString('en-US')} labels on {defaultPlan.rollsRequired} rolls</span>
                    </div>
                    <div class="capacity-bar">
                      <span class="cap-seg cap-base" id="bar-base" style={`width:${defaultTelemetry.baseSharePercent}%`}></span>
                      <span class="cap-seg cap-allow" id="bar-allow" style={`width:${defaultTelemetry.allowanceSharePercent}%`}></span>
                      <span class="cap-seg cap-spare" id="bar-spare" style={`width:${defaultTelemetry.spareSharePercent}%`}></span>
                    </div>
                    <div class="capacity-legend">
                      <span><i class="dot dot-base"></i>Base (<b id="cap-base-num">{defaultPlan.baseLabels.toLocaleString('en-US')}</b>)</span>
                      <span><i class="dot dot-allow"></i>Extra (<b id="cap-allow-num">{defaultTelemetry.allowanceLabels.toLocaleString('en-US')}</b>)</span>
                      <span><i class="dot dot-spare"></i>Spare (<b id="cap-spare-num">{defaultPlan.labelsLeft.toLocaleString('en-US')}</b>)</span>
                    </div>
                  </div>

                  <dl class="ticket-stats">
                    <div><dt>Labels to print, with allowance</dt><dd id="needed">{defaultPlan.labelsNeeded.toLocaleString('en-US')}</dd></div>
                    <div><dt>Rolls this batch uses</dt><dd id="required">{defaultPlan.rollsRequired.toLocaleString('en-US')}</dd></div>
                    <div><dt>Spare labels on those rolls</dt><dd id="left">{defaultPlan.labelsLeft.toLocaleString('en-US')}</dd></div>
                  </dl>
                  <p class="note">Counts the full rolls you already have. Partly used rolls are not included.</p>
                </output>

                <aside class="result-key" aria-labelledby="guide-title">
                  <h2 id="guide-title">Reading your result</h2>
                  <dl class="key-glossary">
                    <div><dt>Rolls to order</dt><dd>What you need to buy after subtracting full shelf stock.</dd></div>
                    <div><dt>Labels to print, with allowance</dt><dd>Your batch plus the extra % for setup and misprints.</dd></div>
                    <div><dt>Rolls this batch uses</dt><dd>Total rolls required, including the ones on your shelf.</dd></div>
                    <div><dt>Spare labels on those rolls</dt><dd>Unused labels left on the final roll after the run.</dd></div>
                  </dl>
                </aside>
              </div>

              <p class="visually-hidden" id="announce" aria-live="polite"></p>
              <noscript><p class="noscript-banner">This calculator needs JavaScript. Formula: round up items × labels per item × (1 + allowance ÷ 100), divide by labels on each roll and round up again, then subtract the full rolls you already have.</p></noscript>
            </div>
          </section>
        </div>
      </section>

      <section class="compare-section" aria-labelledby="compare-title">
        <div class="shell">
          <div class="section-head reveal">
            <div>
              <p class="eyebrow">Roll-size optimizer</p>
              <h2 id="compare-title">Compare standard roll sizes for this exact batch</h2>
            </div>
            <p class="section-sub">See how switching between 250, 500, 1,000 and 2,500 labels per roll changes your order count and leftover stock. Click any card to load that roll size into the press.</p>
          </div>
          <div class="compare-grid reveal" id="compare-grid">
            {defaultComparison.map(row => (
              <article class={`compare-card ${row.isCurrent ? 'is-current' : ''} ${row.isLowestSpare ? 'is-best' : ''}`} data-size={row.labelsPerRoll}>
                <div class="compare-card-top">
                  <span class="compare-size">{row.labelsPerRoll.toLocaleString('en-US')} <small>labels / roll</small></span>
                  {row.isLowestSpare && <span class="compare-badge">Lowest spare</span>}
                </div>
                <p class={`compare-order ${row.rollsToOrder === 0 ? 'is-zero' : ''}`}>
                  <strong>{row.rollsToOrder.toLocaleString('en-US')}</strong> {row.rollsToOrder === 1 ? 'roll' : 'rolls'} to order
                </p>
                <p class="compare-meta">
                  Uses {row.rollsRequired.toLocaleString('en-US')} {row.rollsRequired === 1 ? 'roll' : 'rolls'} · <b>{row.labelsLeft.toLocaleString('en-US')} spare</b> ({row.lastRollUsedPercent}% of last roll used)
                </p>
                <div class="compare-bar" aria-hidden="true">
                  <span style={`width:${row.lastRollUsedPercent}%`}></span>
                </div>
                <button type="button" class="compare-use-btn" data-use-roll={row.labelsPerRoll}>
                  {row.isCurrent ? 'Active roll size' : `Use ${row.labelsPerRoll.toLocaleString('en-US')} / roll`}
                </button>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="explain-band" aria-labelledby="how">
        <div class="shell explain">
          <div class="explain-copy reveal">
            <p class="eyebrow on-dark">Transparent press math</p>
            <h2 id="how">The math, out in the open</h2>
            <p>Multiply your items by labels per item, add the allowance percentage and round up to a whole label. Divide by the labels on each roll and round up to whole rolls. Then subtract the full rolls you already have.</p>
            <p class="example">Example: 250 items × 2 labels = 500, plus 5% = 525 labels. At 500 labels per roll that is 2 rolls. With 1 on the shelf, order 1.</p>
            <p class="fine">The allowance is extra stock, not a yield-loss rate. Results assume identical full rolls. Check your printer's setup needs and any partly used rolls separately.</p>
          </div>
          <ol class="math-steps reveal" aria-label="Live step-by-step calculation">
            <li>
              <span class="step-label">Step 1 · Base batch + setup allowance</span>
              <span class="step-eq">
                <b class="v" id="m-qty">250</b> items × <b class="v" id="m-lpi">2</b> labels = <b class="v" id="m-base">500</b> base, + <b class="v" id="m-waste">5%</b> → <b class="v hl" id="m-needed">525</b> labels
              </span>
            </li>
            <li>
              <span class="step-label">Step 2 · Round up to whole rolls</span>
              <span class="step-eq">
                ⌈ <b class="v" id="m-needed-2">525</b> labels ÷ <b class="v" id="m-per-roll">500</b> per roll ⌉ = <b class="v hl" id="m-req">2</b> rolls required
              </span>
            </li>
            <li>
              <span class="step-label">Step 3 · Subtract shelf stock &amp; find leftover</span>
              <span class="step-eq">
                <b class="v" id="m-req-2">2</b> required − <b class="v" id="m-on-hand">1</b> on hand = <b class="v hl" id="m-order">1</b> to order (<b class="v" id="m-left">475</b> spare)
              </span>
            </li>
          </ol>
        </div>
      </section>

      <section class="press-guide" aria-labelledby="tips-title">
        <div class="shell">
          <p class="eyebrow">Pressroom checklist</p>
          <h2 id="tips-title">Four checks before you send a label order to press</h2>
          <ul class="guide-grid">
            <li class="guide-card reveal">
              <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <circle cx="16" cy="24" r="10" /><circle cx="16" cy="24" r="3" />
                <path d="M16 14h24M28 24h12M28 34h12" />
              </svg>
              <h3>Account for web threading</h3>
              <p>Printers, dispensers and applicators consume extra labels whenever you thread the rollers, calibrate the gap sensor or check registration. How many labels that takes depends on your machine's web path and label height—check your manual and set an allowance that covers setup.</p>
            </li>
            <li class="guide-card reveal">
              <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <rect x="8" y="10" width="32" height="28" rx="4" />
                <path d="M16 20h16M16 28h10" /><circle cx="34" cy="28" r="3" />
              </svg>
              <h3>Count every placement</h3>
              <p>If one container gets a front label, a back panel and a tamper seal from the same roll, set Labels per item to 3. If those placements use separate artwork on different rolls, calculate each roll separately.</p>
            </li>
            <li class="guide-card reveal">
              <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <circle cx="24" cy="24" r="16" /><circle cx="24" cy="24" r="7" />
                <path d="M24 4v6M24 38v6M4 24h6M38 24h6" />
              </svg>
              <h3>Verify core &amp; outer diameter</h3>
              <p>Suppliers wind the same label count onto different core sizes and roll diameters depending on label length. Check your printer or applicator spec sheet for its core inner diameter and maximum roll outer diameter before ordering larger rolls.</p>
            </li>
            <li class="guide-card reveal">
              <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <path d="M12 36V14l12-6 12 6v22l-12 6z" />
                <path d="M12 14l12 6 12-6M24 20v22" />
              </svg>
              <h3>Rotate shelf stock first</h3>
              <p>Pressure-sensitive adhesives have a finite shelf life that depends on the material datasheet, temperature and humidity. Count only sealed, full rolls in your on-hand stock, store spares wrapped away from heat and moisture, and use older rolls first.</p>
            </li>
          </ul>
        </div>
      </section>

      <section class="faq-section" aria-labelledby="faq-title">
        <div class="shell faq-grid">
          <div class="faq-intro reveal">
            <p class="eyebrow">Questions</p>
            <h2 id="faq-title">Label runs &amp; roll sizing, answered</h2>
            <p class="faq-side">Want to see how Rollwise handles your data and hosting? Read our <a href="/privacy/">privacy &amp; assumptions page</a>.</p>
          </div>
          <div class="faq-list reveal">
            {faqs.map(item => (
              <details class="faq-item">
                <summary><h3>{item.q}</h3></summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
