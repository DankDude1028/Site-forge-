---
import { getSiteConfig } from '../../site-config.mjs';
const config = getSiteConfig();
const canonical = new URL('/', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Label Roll Planner — a clearer print run</title>
    <meta name="description" content="Calculate labels, waste allowance, and whole rolls for your next small batch. A free browser-local planning tool." />
    <meta name="robots" content={config.robots} />
    <meta name="theme-color" content="#173d38" />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a href="#main" class="skip">Skip to calculator</a>
    <header class="shell"><a class="brand" href="/" aria-label="Label Roll Planner home"><span class="mark" aria-hidden="true">▥</span> Rollwise <small>PRINT TOOLS</small></a><span class="preview">{config.mode === 'preview' ? 'Private preview' : 'Free planning tool'}</span></header>
    <main id="main" class="shell">
      <div class="intro"><span class="eyebrow">MAKE ROOM FOR THE MAKING.</span><h1>One less thing<br />to count by hand.</h1><p>From the first jar to the last label. Work out exactly how many rolls your next batch needs, with a little breathing room.</p><div class="trust"><span aria-hidden="true">✓</span> No inputs leave your browser</div></div>
      <section class="planner" aria-labelledby="planner-title">
        <div class="card-title"><span class="number">01</span><div><h2 id="planner-title">Plan your label run</h2><p>Start with your batch. We'll handle the rounding.</p></div></div>
        <form id="planner">
          <div class="fields"><div><label for="quantity">Items in this batch</label><input id="quantity" name="quantity" type="number" min="1" max="1000000" step="1" value="250" required inputmode="numeric" /></div><div><label for="labels">Labels per item</label><input id="labels" name="labels" type="number" min="1" max="100" step="1" value="2" required inputmode="numeric" /></div><div><label for="perRoll">Labels on each roll</label><input id="perRoll" name="perRoll" type="number" min="1" max="1000000" step="1" value="500" required inputmode="numeric" /></div><div><label for="onHand">Full rolls you already have</label><input id="onHand" name="onHand" type="number" min="0" max="1000000" step="1" value="1" required inputmode="numeric" /></div></div>
          <div class="buffer"><div><label for="waste">Extra allowance (%)</label><p id="waste-help">For setup, misprints, and the occasional crooked label.</p></div><input id="waste" name="waste" type="number" min="0" max="100" step="0.1" value="5" required aria-describedby="waste-help" inputmode="decimal" /></div>
          <button type="submit">Calculate my rolls <span aria-hidden="true">↗</span></button>
          <p id="error" role="alert"></p>
        </form>
        <output id="result" for="quantity labels perRoll onHand waste" aria-live="polite" aria-atomic="true">
          <div class="answer"><div><span class="eyebrow">ADD TO YOUR SUPPLY LIST</span><strong><span id="order">1</span> <span id="order-label">roll to order</span></strong></div><span class="roll" aria-hidden="true">◉</span></div>
          <dl><div><dt>Total labels, including allowance</dt><dd id="needed">525</dd></div><div><dt>Full rolls needed for the run</dt><dd id="required">2</dd></div><div><dt>Labels left after this run's allowance</dt><dd id="left">475</dd></div></dl>
        </output>
        <noscript><p>This calculator needs JavaScript. Formula: round up items × labels per item × (1 + allowance / 100), divide by labels per roll and round up again, then subtract full rolls on hand.</p></noscript>
      </section>
      <section class="explain" aria-labelledby="how"><div><span class="eyebrow">THE MATH, OUT IN THE OPEN</span><h2 id="how">A small buffer.<br />A smoother batch.</h2></div><div><p>We multiply your items by labels per item, add the percentage allowance, and round up to a whole label. Then we round up to full rolls and subtract the full rolls you already have.</p><p>For example: 250 items × 2 labels + 5% = 525 labels. With 500 labels per roll, you need 2 full rolls. If you have 1, order 1 more.</p><p class="fine">The allowance is extra stock, not a yield-loss rate. This assumes identical full rolls. Check printer setup requirements and any partially used rolls separately.</p></div></section>
    </main>
    <footer class="shell"><span>Rollwise · A SiteForge utility{config.mode === 'preview' ? ' preview' : ''}</span><span>No ads. No affiliate links. No account needed.</span><a href="/privacy/">Privacy &amp; assumptions</a></footer>
    <script src="../scripts/calculator.ts"></script>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;background:#f4f2e9;color:#173d38;font-family:Arial,Helvetica,sans-serif;line-height:1.5}:global(a){color:inherit}:global(:focus-visible){outline:3px solid #bd522c;outline-offset:4px}.shell{width:min(1120px,calc(100% - 48px));margin:auto}header{display:flex;justify-content:space-between;align-items:center;padding:32px 0;border-bottom:1px solid #d2d8c9}.brand{text-decoration:none;font-size:24px;font-weight:800;display:flex;align-items:center;gap:10px}.brand small{font-size:9px;letter-spacing:2px;margin-left:12px}.mark{font-size:32px}.preview{font-size:12px;background:#e8e9d7;border:1px solid #c6cebb;border-radius:20px;padding:5px 12px}main{display:grid;grid-template-columns:1fr 1.05fr;gap:60px;padding-top:72px}.intro{padding-top:28px}.eyebrow{font-size:10px;font-weight:800;letter-spacing:1.8px}h1{font-family:Georgia,serif;font-size:clamp(44px,5.1vw,67px);font-weight:400;line-height:1.08;letter-spacing:-2px;margin:24px 0}p{font-size:15px}.intro>p{max-width:360px;color:#52655d;font-size:17px;line-height:1.7}.trust{font-size:12px;margin-top:30px}.trust span{background:#e0e7d9;border-radius:50%;padding:4px 7px;margin-right:6px}.planner{background:#fffefa;padding:30px;border:1px solid #dadfce;border-radius:16px;box-shadow:0 15px 30px #173d3808}.card-title{display:flex;gap:14px;align-items:start}.number{font-size:12px;background:#edf0e5;border-radius:50%;padding:9px}h2{font-size:21px;letter-spacing:-.6px;margin:0}.card-title p{font-size:12px;margin:3px 0 25px;color:#52655d}.fields{display:grid;grid-template-columns:1fr 1fr;gap:18px 20px}label{display:block;font-size:12px;font-weight:700;margin-bottom:7px}input{width:100%;min-height:45px;background:#fffefa;border:1px solid #aab8a5;border-radius:6px;padding:9px 12px;color:#173d38;font:inherit}.buffer{display:flex;align-items:center;gap:20px;margin-top:22px;border-top:1px solid #e0e4d8;padding-top:20px}.buffer div{flex:1}.buffer label{margin-bottom:3px}.buffer p{font-size:11px;max-width:260px;margin:0;color:#52655d}.buffer input{width:84px}button{display:flex;justify-content:space-between;align-items:center;width:100%;border:0;background:#173d38;color:#fffefa;min-height:48px;padding:12px 16px;border-radius:6px;margin-top:24px;font:700 13px Arial;cursor:pointer}button:hover{background:#24574f}button span{font-size:19px}#error{font-size:12px;color:#a13119;margin:5px 0}output{display:block;background:#edf1df;border:1px solid #d7dfc7;border-radius:9px;margin-top:24px;padding:20px}output[hidden]{display:none}.answer{display:flex;align-items:center;justify-content:space-between}.answer strong{display:block;font-size:41px;letter-spacing:-1.5px}.answer strong>span:last-child{font-size:16px;letter-spacing:-.4px}.answer .eyebrow{font-size:8px}.roll{font-size:50px;color:#566b48}dl{font-size:11px;border-top:1px solid #ccd6bb;padding-top:12px;margin:12px 0 0}dl div{display:flex;justify-content:space-between;gap:10px;padding:4px 0}dd{font-weight:700;margin:0}.explain{grid-column:1/-1;display:grid;grid-template-columns:1fr 1.05fr;gap:60px;border-top:1px solid #d2d8c9;margin-top:8px;padding-top:40px;padding-bottom:60px}.explain h2{font:400 32px/1.2 Georgia,serif;margin-top:15px}.explain p{font-size:13px;color:#52655d;margin:0 0 12px}.explain p.fine{font-size:11px}footer{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:22px 0;border-top:1px solid #d2d8c9;font-size:10px;color:#52655d}.skip{position:absolute;top:-100px;left:20px;background:#fff;padding:12px}.skip:focus{top:8px}@media(max-width:800px){main{grid-template-columns:1fr;gap:30px;padding-top:25px}.intro{padding-top:0}.intro>p{max-width:580px}.trust{margin-top:18px}.explain{grid-template-columns:1fr;gap:20px;padding-bottom:25px;margin-top:10px}.planner{max-width:600px}.brand small{display:none}h1{font-size:52px}}@media(max-width:420px){.shell{width:calc(100% - 28px)}header{padding:20px 0}.planner{padding:20px}.fields{gap:16px 12px}h1{font-size:43px}.preview{font-size:10px}.brand{font-size:21px}.explain{gap:15px}}@media(prefers-reduced-motion:reduce){:global(*){scroll-behavior:auto!important}}
</style>
