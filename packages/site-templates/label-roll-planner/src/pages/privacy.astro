---
import { getSiteConfig } from '../../site-config.mjs';
const config = getSiteConfig();
const canonical = new URL('/privacy/', Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Privacy &amp; assumptions — Rollwise</title><meta name="robots" content={config.robots} /><link rel="canonical" href={canonical} /><meta name="description" content="How the calculator handles data and its planning assumptions." /></head><body><main style="max-width:680px;margin:60px auto;padding:24px;font:18px/1.7 Arial;color:#173d38"><a href="/">← Back to calculator</a><h1>Privacy &amp; assumptions</h1><p>The calculator runs in your browser. It does not send inputs to a server, use cookies, store your figures, load advertising, or contact analytics services. Hosting providers may process basic request logs; review the chosen host's privacy terms.</p><p>Results assume full, identical rolls. The waste percentage adds an allowance to the base label count. It does not model printer yield, roll leaders, label dimensions, or partially used rolls. Confirm those details with your printer.</p><p>{config.mode === 'preview' ? 'This is a private preview. ' : ''}This utility uses synthetic research; demand has not been independently validated. There are no affiliate links or enrolled monetization providers.</p></main></body></html>
