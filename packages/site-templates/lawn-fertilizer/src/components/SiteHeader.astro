---
const { mode } = Astro.props;
---
<header class="site-header">
  <div class="shell header-row">
    <a class="brand" href="/">
      <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <circle cx="20" cy="20" r="18" fill="currentColor" opacity=".14" />
        <path d="M12 31c1-7 3-12 7-16M20 31c0-8 1-14 3-20M28 31c-1-6-3-10-6-13" fill="none" stroke="currentColor"
          stroke-width="2.6" stroke-linecap="round" />
        <circle cx="23" cy="9" r="2.4" fill="var(--sun)" />
      </svg>
      <span>Turfwise</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        <li><a href="/#planner">Calculator</a></li>
        <li><a href="/#calendar">When to feed</a></li>
        <li><a href="/#math">The math</a></li>
        <li><a href="/method/">Method</a></li>
      </ul>
    </nav>
    {mode === 'preview' && <span class="proof">Proof · not published</span>}
  </div>
</header>
