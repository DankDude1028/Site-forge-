---
import type { Photo } from '../lib/photos.ts';

interface Props { photo: Photo; priority?: boolean; caption?: boolean; paper?: boolean }
const { photo, priority = false, caption = true, paper = false } = Astro.props;
const widths = [800, 1200];
const webp = widths.map((width) => `${photo.base}-${width}.webp ${width}w`).join(', ');
const jpeg = widths.map((width) => `${photo.base}-${width}.jpg ${width}w`).join(', ');
---
<figure class:list={['grass-figure', paper && 'on-paper']}>
  <picture>
    <source type="image/webp" srcset={webp} sizes="(max-width: 860px) 100vw, 520px" />
    <img src={`${photo.base}-800.jpg`} srcset={jpeg} sizes="(max-width: 860px) 100vw, 520px"
      width={photo.width} height={photo.height} alt={photo.alt}
      loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : undefined} />
  </picture>
  {caption && <figcaption>
    {photo.photographer}. <a href={photo.licenseUrl}>{photo.license}</a>.
    <a href="/credits/">Photo credits</a>.
  </figcaption>}
</figure>
