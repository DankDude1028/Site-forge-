---
import { GRASS_GUIDES, TOOL_GUIDES } from '../lib/site.ts';

interface Props { current: string }
const { current } = Astro.props;
const links = [...TOOL_GUIDES, ...GRASS_GUIDES].filter((page) => page.path !== current).slice(0, 6);
---
<section class="related" aria-labelledby="related-title">
  <div class="shell">
    <p class="eyebrow">Keep going</p>
    <h2 id="related-title">More from Lawn Numbers</h2>
    <ul class="related-grid">
      <li class="related-card calc-card">
        <a href="/#planner"><span class="related-kicker">Calculator</span><strong>Work out your fertilizer</strong><span>Pounds to spread, bags to buy and the spreader target, from your lawn and your bag.</span></a>
      </li>
      {links.map((page) => (
        <li class="related-card"><a href={page.path}><span class="related-kicker">{page.path.startsWith('/grass/') ? 'Grass guide' : 'Guide'}</span><strong>{page.title}</strong><span>{page.blurb}</span></a></li>
      ))}
    </ul>
  </div>
</section>
