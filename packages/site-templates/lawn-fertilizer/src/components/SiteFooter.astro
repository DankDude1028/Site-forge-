---
const { mode } = Astro.props;
---
<footer class="site-footer">
  <div class="shell footer-row">
    <div class="footer-brand">
      <strong>Turfwise</strong>
      <span>Lawn fertilizer calculator{mode === 'preview' ? ' (preview)' : ''}</span>
    </div>
    <p class="footer-note">Results are estimates from university extension formulas. Your product label and your state's rules come first. What you type never leaves your browser.</p>
    <ul class="footer-links">
      <li><a href="/method/">Method &amp; sources</a></li>
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href="/terms/">Terms &amp; disclaimer</a></li>
    </ul>
  </div>
</footer>
