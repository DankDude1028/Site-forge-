---
import Base from '../layouts/Base.astro';
import GuideHero from './GuideHero.astro';
import Planner from './Planner.astro';
import SourceList from './SourceList.astro';
import RelatedGuides from './RelatedGuides.astro';
import { RANGES, type SizeRange } from '../content/ranges.ts';
import { SIZES, bagsFor, productPounds } from '../lib/sizes.ts';
import { pounds } from '../lib/format.ts';

interface Props { range: SizeRange }
const { range } = Astro.props;
const path = `/lawn-size/${range.slug}/`;
const product = productPounds(range.exampleArea, range.nitrogen, range.rate);
const bags = bagsFor(product, 25);
const perThousand = product / (range.exampleArea / 1000);
const linked = SIZES.filter((size) => range.links.includes(size.slug));
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Calculator', item: new URL('/', Astro.site).href },
  { '@type': 'ListItem', position: 2, name: 'Lawn size', item: new URL('/lawn-size/', Astro.site).href },
  { '@type': 'ListItem', position: 3, name: range.title, item: new URL(path, Astro.site).href },
] }];
---
<Base title={`Fertilizer for Lawns ${range.title} | Lawn Numbers`}
  description={`A worked fertilizer example for a lawn ${range.label}: ${range.exampleArea.toLocaleString('en-US')} sq ft using ${range.productName} at ${range.rate} lb of nitrogen per 1,000 sq ft.`}
  path={path} jsonLd={jsonLd}>
  <main id="main">
    <GuideHero eyebrow="By lawn size" title={`Lawns ${range.label}`} lede={range.lede}
      crumbs={[{ name: 'Calculator', path: '/' }, { name: 'Lawn size', path: '/lawn-size/' }, { name: range.label }]}>
      <div slot="art" class="size-art" aria-hidden="true">
        <span class="size-art-label">{range.exampleArea.toLocaleString('en-US')}</span>
        <span class="size-art-scale">example square feet, not the whole band</span>
      </div>
    </GuideHero>
    <section class="guide-body">
      <div class="shell prose-wide">
        <p class="eyebrow">Worked example</p>
        <h2>{range.exampleArea.toLocaleString('en-US')} sq ft of {range.productName}</h2>
        <p>{range.exampleShape}. One feeding at {range.rate} lb of nitrogen per 1,000 sq ft.</p>
        <ul class="glance-grid range-stats">
          <li class="glance-card"><span class="glance-label">Nitrogen</span><strong>{pounds(range.rate * range.exampleArea / 1000)} lb</strong><span>in this feeding</span></li>
          <li class="glance-card"><span class="glance-label">{range.productName}</span><strong>{pounds(product)} lb</strong><span>{pounds(perThousand)} lb per 1,000 sq ft</span></li>
          <li class="glance-card"><span class="glance-label">25 lb bags</span><strong>{bags}</strong><span>{pounds(bags * 25 - product)} lb left over if you buy {bags}</span></li>
        </ul>
        {range.story.map((paragraph) => <p set:html={paragraph} />)}
        <p>The same formula is on the <a href="/method/">method page</a>: pounds of product = nitrogen rate ÷ (first bag number ÷ 100) × area ÷ 1,000. Bags round up.</p>
        <h2>Exact sizes inside and beside this band</h2>
        <ul class="size-chips">
          {linked.map((size) => <li><a class="size-chip" href={`/lawn-size/${size.slug}/`}>{size.label}</a></li>)}
          {RANGES.filter((other) => other.slug !== range.slug).map((other) => (
            <li><a class="size-chip" href={`/lawn-size/${other.slug}/`}>{other.label}</a></li>
          ))}
          <li><a class="size-chip" href="/bags/">Bag sizes</a></li>
        </ul>
      </div>
    </section>
    <section class="planner-section" aria-labelledby="calc-title">
      <div class="shell">
        <p class="eyebrow">Calculator</p>
        <h2 id="calc-title">Start from this example</h2>
        <p class="section-intro">The calculator opens on this example: the area, the rate, a 25 lb bag, and {range.productName}. Change any of them. The formula does not change.</p>
        <Planner area={range.exampleArea} rate={range.rate} nitrogen={range.nitrogen} phosphorus={range.phosphorus}
          potassium={range.potassium} bagWeight={25} />
      </div>
    </section>
    <RelatedGuides current={path} />
    <div class="shell"><SourceList keys={['iowa', 'rutgers', 'ufRule']} /></div>
  </main>
</Base>
<script>
  import '../scripts/planner.ts';
</script>
