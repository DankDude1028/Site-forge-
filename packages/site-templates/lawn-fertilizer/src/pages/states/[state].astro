---
import Base from '../../layouts/Base.astro';
import GuideHero from '../../components/GuideHero.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import { STATES, type StateGuide } from '../../content/states.ts';
import { GRASSES } from '../../lib/grasses.ts';

export function getStaticPaths() {
  return STATES.map((state) => ({ params: { state: state.slug }, props: { state } }));
}

interface Props { state: StateGuide }
const { state } = Astro.props;
const path = `/states/${state.slug}/`;
const grasses = state.grasses.map((id) => GRASSES.find((grass) => grass.id === id)).filter((grass) => grass !== undefined);
const plain = (html: string) => html.replace(/<[^>]+>/g, '');
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Calculator', item: new URL('/', Astro.site).href },
  { '@type': 'ListItem', position: 2, name: 'States', item: new URL('/states/', Astro.site).href },
  { '@type': 'ListItem', position: 3, name: state.name, item: new URL(path, Astro.site).href },
] }];
---
<Base title={`${state.name} Lawn Fertilizer Rules | Lawn Numbers`}
  description={plain(state.summary)} path={path} jsonLd={jsonLd}>
  <main id="main">
    <GuideHero eyebrow={`${state.abbr} · State rules`} title={`${state.name} fertilizer rules`} lede={state.summary}
      crumbs={[{ name: 'Calculator', path: '/' }, { name: 'States', path: '/states/' }, { name: state.name }]}>
      <p slot="art" class="state-mark" aria-hidden="true">{state.abbr}</p>
    </GuideHero>
    <article class="guide-body">
      <div class="shell prose-wide">
        {state.sections.map((section) => (
          <section aria-labelledby={`${section.id}-title`}>
            <h2 id={`${section.id}-title`}>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
          </section>
        ))}
        <h2>Grasses to read next</h2>
        <ul class="size-chips">
          {grasses.map((grass) => <li><a class="size-chip" href={`/grass/${grass.id}/`}>{grass.name}</a></li>)}
          <li><a class="size-chip" href="/seasons/">Seasons</a></li>
          <li><a class="size-chip" href="/#planner">Calculator</a></li>
        </ul>
        <h2>Not verified for this page</h2>
        <ul>{state.unverified.map((item) => <li>{item}</li>)}</ul>
        <p>If an item is on that list, check your county extension office or the state agency linked below. This page will not guess.</p>
        <aside class="source-list">
          <h2>Sources</h2>
          <ol>{state.sources.map((source) => <li><a href={source.url}>{source.name}</a></li>)}</ol>
        </aside>
      </div>
    </article>
    <RelatedGuides current={path} />
  </main>
</Base>
