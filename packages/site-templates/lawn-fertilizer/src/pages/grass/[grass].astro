---
import Base from '../../layouts/Base.astro';
import GuideHero from '../../components/GuideHero.astro';
import GrassFigure from '../../components/GrassFigure.astro';
import Calendar from '../../components/Calendar.astro';
import Planner from '../../components/Planner.astro';
import SourceList from '../../components/SourceList.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import { GRASS_ARTICLES } from '../../content/grass-articles.ts';
import { GRASSES, MONTHS, feedingsPerYear, type Grass } from '../../lib/grasses.ts';
import { planFertilizer } from '../../lib/fertilizer.ts';
import { fixed, pounds } from '../../lib/format.ts';
import { GRASS_PHOTOS } from '../../lib/photos.ts';
import { inline } from '../../lib/site.ts';
import type { SourceKey } from '../../lib/sources.ts';

export function getStaticPaths() {
  return GRASSES.map((grass) => ({ params: { grass: grass.id }, props: { grass } }));
}

interface Props { grass: Grass }
const { grass } = Astro.props;
const article = GRASS_ARTICLES[grass.id];
if (!article) throw new Error(`Missing article for ${grass.id}`);
const photo = GRASS_PHOTOS[grass.id];
if (!photo) throw new Error(`Missing photo for ${grass.id}`);
const name = inline(grass);
const path = `/grass/${grass.id}/`;
const FULL = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November',
  'December'];
const monthsOf = (kind: string) => Object.entries(grass.months).filter(([, feed]) => feed === kind).map(([month]) => Number(month));
const list = (months: number[]) => months.map((month) => FULL[month])
  .reduce((text, item, index, all) => index === 0 ? item : `${text}${index === all.length - 1 ? ' and ' : ', '}${item}`, '');
const main = list(monthsOf('main'));
const mainMonths = monthsOf('main');
const consecutive = mainMonths.every((month, index) => index === 0 || month === mainMonths[index - 1] + 1);
const mainShort = mainMonths.length > 1 && consecutive
  ? `${MONTHS[mainMonths[0]]}–${MONTHS[mainMonths.at(-1)!]}` : mainMonths.map((month) => MONTHS[month]).join(' & ');
const [fewest, most] = feedingsPerYear(grass, grass.rate);
const range = `${grass.annual[0]}–${grass.annual[1]}`;
const cool = grass.season === 'cool';
const rate = fixed(grass.rate, grass.rate === 0.75 ? 2 : 1);
const plain = (html: string) => html.replace(/<[^>]+>/g, '');

const examples = [[29, 0, 4], [16, 4, 8], [10, 10, 10], [46, 0, 0]].map(([nitrogen, phosphorus, potassium]) => {
  const result = planFertilizer({ area: 5000, nitrogen, phosphorus, potassium, rate: grass.rate, bagWeight: 50 });
  if (!result.ok) throw new Error('Example inputs must be valid');
  return { label: `${nitrogen}-${phosphorus}-${potassium}`, per: fixed(result.plan.productPerThousand, 1), total: pounds(result.plan.productTotal) };
});
const sources: SourceKey[] = cool ? ['nebraska', 'ncstate', 'ncLawns', 'iowa', 'rutgers'] : ['ufRule', 'ncLawns', 'iowa', 'rutgers'];
const faqs = article.faqs;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Calculator', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: `${grass.name} fertilizer guide`, item: new URL(path, Astro.site).href },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: plain(item.a) } })) },
];
---
<Base title={`${grass.name} Fertilizer Guide: How Much and When to Feed | Lawn Numbers`}
  description={`How much fertilizer ${name} needs (${range} lb of nitrogen per 1,000 sq ft a year), when to feed it, and a calculator set up for ${name}.`}
  path={path} image={`/og/${grass.id}.jpg`} imageAlt={photo.alt} jsonLd={jsonLd}>
  <main id="main">
    <GuideHero eyebrow={cool ? 'Cool-season grass' : 'Warm-season grass'} title={`How to fertilize ${name}`}
      lede={`${grass.intro} The feeding months, the yearly nitrogen, and a calculator already set to this grass are below. The label on your bag still wins.`}
      crumbs={[{ name: 'Calculator', path: '/' }, { name: 'Guides', path: '/guides/' }, { name: grass.name }]} artHidden={false}>
      <GrassFigure slot="art" photo={photo} priority />
    </GuideHero>

    <section class="glance" aria-labelledby="glance-title">
      <div class="shell">
        <h2 id="glance-title" class="sr-only">{grass.name} at a glance</h2>
        <ul class="glance-grid">
          <li class="glance-card reveal"><span class="glance-label">Nitrogen a year</span><strong>{range} lb</strong><span>per 1,000 sq ft</span></li>
          <li class="glance-card reveal"><span class="glance-label">Main feedings</span><strong>{mainShort || main}</strong><span>{cool ? 'fall matters most' : 'after green-up'}</span></li>
          <li class="glance-card reveal"><span class="glance-label">Per feeding</span><strong>{rate} lb N</strong><span>usual band 0.5–1 lb</span></li>
          <li class="glance-card reveal"><span class="glance-label">Feedings a year</span><strong>{fewest === most ? fewest : `${fewest}–${most}`}</strong><span>at {rate} lb each</span></li>
        </ul>
      </div>
    </section>

    <article class="guide-body">
      <div class="shell prose-wide grass-article">
        {article.sections.map((section) => (
          <section id={section.id} aria-labelledby={`${section.id}-title`}>
            <h2 id={`${section.id}-title`}>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
          </section>
        ))}
      </div>
    </article>

    <Calendar grass={grass.id} locked rate={grass.rate} heading={`When to feed ${name}`} eyebrow="Feeding calendar" />

    <section class="planner-section" id="planner-anchor" aria-labelledby="calc-title">
      <div class="shell">
        <p class="eyebrow">Calculator</p>
        <h2 id="calc-title">How much to spread on your {name}</h2>
        <p class="section-intro">It starts at {rate} lb of nitrogen per 1,000 sq ft on a 5,000 sq ft lawn. Change the numbers to match your lawn and your bag. Nothing you type is sent anywhere.</p>
        <Planner rate={grass.rate} area={5000} />
      </div>
    </section>

    <section class="examples" aria-labelledby="examples-title">
      <div class="shell">
        <p class="eyebrow">Worked examples</p>
        <h2 id="examples-title">One feeding on 5,000 sq ft of {name}</h2>
        <p class="section-intro">At {rate} lb of nitrogen per 1,000 sq ft. These four analyses are the same products as the size pages, so you can compare grasses instead of comparing formulas.</p>
        <div class="table-wrap" tabindex="0" role="region" aria-label={`Worked examples for ${name}`}>
          <table>
            <thead><tr><th scope="col">Bag numbers</th><th scope="col">Per 1,000 sq ft</th><th scope="col">For 5,000 sq ft</th></tr></thead>
            <tbody>{examples.map((row) => <tr><th scope="row">{row.label}</th><td>{row.per} lb</td><td>{row.total} lb</td></tr>)}</tbody>
          </table>
        </div>
        <p class="section-intro">Other areas: <a href="/lawn-size/">lawn size guide</a>. Other bag weights: <a href="/bags/">15, 25, 40, and 50 lb</a>. State rules: <a href="/states/">Gulf and Southeast</a>.</p>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-title">
      <div class="shell faq-grid">
        <div>
          <p class="eyebrow">Questions</p>
          <h2 id="faq-title">{grass.name}, answered</h2>
        </div>
        <div class="faq-list">
          {faqs.map((item) => <details class="faq-item"><summary><h3>{item.q}</h3></summary><p set:html={item.a} /></details>)}
        </div>
      </div>
    </section>

    <div class="shell"><SourceList keys={sources} /></div>
    <RelatedGuides current={path} />
  </main>
</Base>

<script>
  import '../../scripts/planner.ts';
</script>
