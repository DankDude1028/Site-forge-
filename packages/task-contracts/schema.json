{
  "schema_version": 1,
  "contracts": {
    "AgentContext": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "site_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site Id"
        },
        "allowed_tools": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array"
        },
        "budget_remaining": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Budget Remaining"
        },
        "deadline": {
          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "policy_version": {
          "default": "1",
          "title": "Policy Version",
          "type": "string"
        },
        "source_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Source Requirements",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "allowed_tools",
        "budget_remaining",
        "deadline"
      ],
      "title": "AgentContext",
      "type": "object"
    },
    "AgentResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "completed",
            "blocked",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "error_code": {
          "default": "none",
          "enum": [
            "none",
            "local_model_unavailable",
            "inference_busy",
            "model_not_ready",
            "model_identity_changed",
            "invalid_model_response",
            "policy_blocked",
            "deadline_exceeded",
            "execution_limit",
            "context_limit",
            "tool_execution_failed"
          ],
          "title": "Error Code",
          "type": "string"
        },
        "artifacts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "evidence": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Evidence",
          "type": "array"
        },
        "costs": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Costs"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "next_actions": {
          "items": {
            "type": "string"
          },
          "title": "Next Actions",
          "type": "array"
        }
      },
      "required": [
        "status",
        "confidence"
      ],
      "title": "AgentResult",
      "type": "object"
    },
    "TaskCreate": {
      "$defs": {
        "AgentType": {
          "enum": [
            "portfolio_director",
            "research",
            "developer",
            "content",
            "quality",
            "growth",
            "revenue"
          ],
          "title": "AgentType",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "agent_type": {
          "$ref": "#/$defs/AgentType"
        },
        "capability": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "idempotency_key": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "site_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site Id"
        },
        "workflow_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Id"
        },
        "dependencies": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Dependencies",
          "type": "array"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "deadline": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline"
        },
        "budget_cap": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Budget Cap"
        }
      },
      "required": [
        "agent_type",
        "capability",
        "idempotency_key"
      ],
      "title": "TaskCreate",
      "type": "object"
    },
    "TaskView": {
      "$defs": {
        "JobState": {
          "enum": [
            "pending",
            "ready",
            "leased",
            "running",
            "completed",
            "blocked",
            "waiting_approval",
            "retry_scheduled",
            "failed",
            "cancelled"
          ],
          "title": "JobState",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "org_id": {
          "title": "Org Id",
          "type": "string"
        },
        "agent_type": {
          "title": "Agent Type",
          "type": "string"
        },
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "status": {
          "$ref": "#/$defs/JobState"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "site_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Site Id"
        },
        "workflow_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Workflow Id"
        },
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "max_attempts": {
          "title": "Max Attempts",
          "type": "integer"
        },
        "deadline": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deadline"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "lease_worker_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lease Worker Id"
        },
        "lease_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lease Expires At"
        },
        "lease_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Token"
        },
        "budget_cap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Budget Cap"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        }
      },
      "required": [
        "id",
        "org_id",
        "agent_type",
        "capability",
        "input",
        "status",
        "idempotency_key",
        "site_id",
        "workflow_id",
        "attempt",
        "max_attempts",
        "deadline",
        "available_at",
        "lease_worker_id",
        "lease_expires_at",
        "budget_cap",
        "result",
        "error_code"
      ],
      "title": "TaskView",
      "type": "object"
    }
  }
}
