# Generate separate random tokens locally; never paste real tokens into Git.
SITEFORGE_DATABASE_URL=postgresql+psycopg://siteforge:local-dev-only@127.0.0.1:5432/siteforge
SITEFORGE_OWNER_TOKEN=replace-with-64-random-hex-characters
SITEFORGE_WORKER_TOKEN=replace-with-a-different-64-random-hex-token
SITEFORGE_ORG_ID=00000000-0000-0000-0000-000000000001
SITEFORGE_WORKER_ID=00000000-0000-0000-0000-000000000002
SITEFORGE_WORKER_TOKEN_EXPIRES_AT=replace-with-UTC-timestamp-within-24-hours
SITEFORGE_API_URL=http://127.0.0.1:8080
SITEFORGE_SUPERVISOR_URL=http://127.0.0.1:8080
SITEFORGE_LMSTUDIO_URL=http://127.0.0.1:1234
SITEFORGE_ARTIFACT_ROOT=runtime/artifacts
SITEFORGE_EXTERNAL_BUDGET_USD=0
# Optional integrations are disabled until configured and approved.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional internal weekly review; never sends messages.
SITEFORGE_SCHEDULE_WEEKLY_REVIEWS=false
# Durable releases remain disabled until protected-site and known-cost configuration.
SITEFORGE_RELEASE_ENABLED=false
SITEFORGE_RELEASE_PRODUCTION_ENABLED=false
SITEFORGE_RELEASE_SITE_BINDINGS={}
SITEFORGE_RELEASE_PROTECTED_SITES=[]
SITEFORGE_PREVIEW_ROOT=runtime/previews
SITEFORGE_PREVIEW_AUTHORIZATION=
SITEFORGE_RELEASE_KNOWN_COST_USD=
SITEFORGE_RELEASE_MAX_COST_USD=0
SITEFORGE_RELEASE_PRODUCTION_ORIGINS={}
SITEFORGE_RELEASE_EXCLUSIVE_PUBLISHER=false
SITEFORGE_RELEASE_RESUME_UPLOADS_ENABLED=false
SITEFORGE_RELEASE_RESUME_COST_USD=
# Client-only owner credential; use a protected secret, never a command argument.
SITEFORGE_RELEASE_TOKEN=
